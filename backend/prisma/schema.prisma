generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlserver"
}

model AdminUser {
  id                  Int        @id @default(autoincrement())
  name                String     @db.NVarChar(120)
  email               String     @unique @db.NVarChar(255)
  passwordHash        String     @db.NVarChar(255)
  role                String     @default("ADMIN") @db.VarChar(30)
  isActive            Boolean    @default(true)
  mustChangePassword  Boolean    @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  expenses            Expense[]
  updatedPages        PageContent[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  adminId   Int
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, expiresAt])
}

model SiteSettings {
  id                 Int      @id @default(1)
  brandName          String   @default("DIVA Candles") @db.NVarChar(120)
  logoUrl            String?  @db.NVarChar(1000)
  faviconUrl         String?  @db.NVarChar(1000)
  phone              String   @default("+91 84218 69308") @db.VarChar(30)
  whatsappNumber     String   @default("918421869308") @db.VarChar(30)
  notificationEmail  String   @default("info.divacandles@gmail.com") @db.NVarChar(255)
  address            String?  @db.NVarChar(500)
  businessHours      String?  @db.NVarChar(500)
  googleMapsUrl      String?  @db.NVarChar(1000)
  instagramUrl       String?  @db.NVarChar(1000)
  facebookUrl        String?  @db.NVarChar(1000)
  youtubeUrl         String?  @db.NVarChar(1000)
  linkedinUrl        String?  @db.NVarChar(1000)
  amazonStoreUrl     String?  @db.NVarChar(1000)
  amazonStoreEnabled Boolean  @default(false)
  seoTitle           String?  @db.NVarChar(160)
  seoDescription     String?  @db.NVarChar(500)
  homepageHeroTitle  String?  @db.NVarChar(240)
  homepageHeroText   String?  @db.NVarChar(1000)
  currency           String   @default("INR") @db.VarChar(10)
  taxPercentage      Decimal  @default(0) @db.Decimal(5, 2)
  paymentEnabled     Boolean  @default(false)
  razorpayEnabled    Boolean  @default(false)
  whatsappApiEnabled Boolean  @default(false)
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @db.NVarChar(120)
  slug         String    @unique @db.VarChar(160)
  description  String?   @db.NVarChar(2000)
  imageUrl     String?   @db.NVarChar(1000)
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  @@index([isActive, displayOrder])
}

model Product {
  id                  Int            @id @default(autoincrement())
  sku                 String         @unique @db.VarChar(80)
  name                String         @db.NVarChar(200)
  slug                String         @unique @db.VarChar(220)
  shortDescription    String?        @db.NVarChar(500)
  description         String         @db.NVarChar(Max)
  fragrance           String?        @db.NVarChar(120)
  waxType             String?        @db.NVarChar(120)
  colour              String?        @db.NVarChar(80)
  size                String?        @db.NVarChar(80)
  weight              String?        @db.NVarChar(80)
  burnTime            String?        @db.NVarChar(80)
  price               Decimal        @db.Decimal(12, 2)
  compareAtPrice      Decimal?       @db.Decimal(12, 2)
  discountPercentage Decimal         @default(0) @db.Decimal(5, 2)
  stockQuantity       Int            @default(0)
  lowStockThreshold   Int            @default(5)
  stockStatus         String         @default("IN_STOCK") @db.VarChar(30)
  categoryId          Int
  amazonUrl           String?        @db.NVarChar(1000)
  isFeatured          Boolean        @default(false)
  isBestSeller        Boolean        @default(false)
  isNewArrival        Boolean        @default(false)
  isCustomisable      Boolean        @default(false)
  isBulkAvailable     Boolean        @default(false)
  bulkMOQ             Int?
  bulkUnit            String?        @db.NVarChar(40)
  bulkStartingPrice   Decimal?       @db.Decimal(12, 2)
  bulkPriceVisible    Boolean        @default(false)
  bulkDescription     String?        @db.NVarChar(2000)
  customPackagingAvailable Boolean   @default(false)
  customColourAvailable Boolean      @default(false)
  customFragranceAvailable Boolean   @default(false)
  customBrandingAvailable Boolean    @default(false)
  giftMessageAvailable Boolean       @default(false)
  eventBrandingAvailable Boolean     @default(false)
  ribbonTagsAvailable Boolean        @default(false)
  whatsappAvailable   Boolean        @default(true)
  isActive            Boolean        @default(false)
  seoTitle            String?        @db.NVarChar(200)
  seoDescription      String?        @db.NVarChar(500)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  category            Category       @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  inquiries           Inquiry[]
  orderItems          OrderItem[]
  bulkPricingTiers    BulkPricingTier[]
  @@index([categoryId, isActive, deletedAt])
  @@index([isFeatured, isBestSeller, isNewArrival])
}

model BulkPricingTier {
  id              Int      @id @default(autoincrement())
  productId       Int
  minimumQuantity Int
  maximumQuantity Int?
  pricePerUnit    Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, minimumQuantity])
}

model TeamMember {
  id                 Int      @id @default(autoincrement())
  name               String   @db.NVarChar(150)
  designation        String   @db.NVarChar(200)
  description        String   @db.NVarChar(Max)
  profileImageUrl    String?  @db.NVarChar(1000)
  cloudinaryPublicId String?  @db.NVarChar(255)
  displayOrder       Int      @default(0)
  isFounder          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([isActive, displayOrder])
}

model ProductImage {
  id                 Int      @id @default(autoincrement())
  productId          Int
  imageUrl           String   @db.NVarChar(1000)
  cloudinaryPublicId String?  @db.NVarChar(255)
  altText            String   @db.NVarChar(255)
  displayOrder       Int      @default(0)
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, displayOrder])
}

model Banner {
  id                 Int      @id @default(autoincrement())
  title              String   @db.NVarChar(200)
  subtitle           String?  @db.NVarChar(500)
  imageUrl           String   @db.NVarChar(1000)
  cloudinaryPublicId String?  @db.NVarChar(255)
  buttonText         String?  @db.NVarChar(80)
  buttonUrl          String?  @db.NVarChar(1000)
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([isActive, displayOrder])
}

model Inquiry {
  id                    Int      @id @default(autoincrement())
  inquiryNumber         String   @unique @db.VarChar(40)
  inquiryType           String   @default("GENERAL") @db.VarChar(40)
  customerName          String   @db.NVarChar(150)
  phone                 String   @db.VarChar(30)
  email                 String?  @db.NVarChar(255)
  city                  String?  @db.NVarChar(120)
  productId             Int?
  quantity              Int?
  occasion              String?  @db.NVarChar(160)
  preferredContactMethod String? @db.VarChar(30)
  message               String   @db.NVarChar(Max)
  status                String   @default("NEW") @db.VarChar(30)
  source                String   @default("WEBSITE") @db.VarChar(40)
  emailNotificationSent Boolean  @default(false)
  whatsappActionUsed    Boolean  @default(false)
  adminNotes            String?  @db.NVarChar(Max)
  unit                  String?  @db.NVarChar(40)
  requiredDeliveryDate  DateTime?
  customisationRequired Boolean  @default(false)
  customisationDetails  String?  @db.NVarChar(3000)
  budget                 Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  product               Product? @relation(fields: [productId], references: [id])
  @@index([status, createdAt])
  @@index([inquiryType])
}

model FAQ {
  id           Int      @id @default(autoincrement())
  question     String   @db.NVarChar(500)
  answer       String   @db.NVarChar(Max)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([isActive, displayOrder])
}

model PageContent {
  id             Int        @id @default(autoincrement())
  pageKey        String     @unique @db.VarChar(50)
  title          String     @db.NVarChar(200)
  content        String     @db.NVarChar(Max)
  isPublished    Boolean    @default(false)
  updatedAt      DateTime   @updatedAt
  updatedById    Int?
  updatedBy      AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  @@index([isPublished, pageKey])
}

model Testimonial {
  id            Int      @id @default(autoincrement())
  customerName  String   @db.NVarChar(150)
  designation   String?  @db.NVarChar(150)
  rating        Int      @default(5)
  message       String   @db.NVarChar(2000)
  imageUrl      String?  @db.NVarChar(1000)
  isApproved    Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.NVarChar(255)
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  adminUserId  Int?
  action       String     @db.VarChar(80)
  entityType   String     @db.VarChar(80)
  entityId     String?    @db.VarChar(80)
  previousData String?    @db.NVarChar(Max)
  newData      String?    @db.NVarChar(Max)
  ipAddress    String?    @db.VarChar(64)
  userAgent    String?    @db.NVarChar(500)
  createdAt    DateTime   @default(now())
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ClickEvent {
  id        Int      @id @default(autoincrement())
  eventType String   @db.VarChar(40)
  productId Int?
  targetUrl String?  @db.NVarChar(1000)
  createdAt DateTime @default(now())
  @@index([eventType, createdAt])
}

model StockReservation {
  id                Int      @id @default(autoincrement())
  reservationNumber String   @unique @db.VarChar(50)
  clientToken       String   @unique @db.VarChar(80)
  itemsData         String   @db.NVarChar(Max)
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model Expense {
  id               Int       @id @default(autoincrement())
  expenseNumber    String    @unique @db.VarChar(50)
  title            String    @db.NVarChar(200)
  category         String    @db.NVarChar(100)
  subCategory      String?   @db.NVarChar(120)
  expenseType      String    @default("BUSINESS") @db.VarChar(30)
  quantity         Decimal   @default(1) @db.Decimal(12, 2)
  unitCost         Decimal   @default(0) @db.Decimal(12, 2)
  baseAmount       Decimal   @default(0) @db.Decimal(12, 2)
  amount           Decimal   @db.Decimal(12, 2)
  gstPercent       Decimal   @default(0) @db.Decimal(5, 2)
  gstAmount        Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus    String    @default("PAID") @db.VarChar(20)
  expenseDate      DateTime
  dueDate          DateTime?
  vendor           String?   @db.NVarChar(200)
  paymentMethod    String?   @db.NVarChar(80)
  referenceNumber  String?   @db.NVarChar(120)
  notes            String?   @db.NVarChar(2000)
  receiptUrl       String?   @db.NVarChar(1000)
  createdByAdminId Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        AdminUser @relation(fields: [createdByAdminId], references: [id])

  @@index([expenseDate, category])
  @@index([expenseDate, id])
  @@index([category, expenseDate])
  @@index([paymentStatus, expenseDate])
  @@index([createdByAdminId])
}

model Order {
  id              Int               @id @default(autoincrement())
  orderNumber     String            @unique @db.VarChar(40)
  status          String            @default("PENDING") @db.VarChar(30)
  customerName    String            @db.NVarChar(150)
  email           String?           @db.NVarChar(255)
  phone           String            @db.VarChar(30)
  subtotal        Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           OrderItem[]
  payment         Payment?
  shippingAddress ShippingAddress?
  couponId        Int?
  coupon          Coupon?           @relation(fields: [couponId], references: [id])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String  @db.NVarChar(200)
  sku       String  @db.VarChar(80)
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                    Int      @id @default(autoincrement())
  orderId               Int      @unique
  provider              String   @db.VarChar(30)
  providerOrderId       String?  @db.NVarChar(150)
  providerPaymentId     String?  @db.NVarChar(150)
  signatureVerified     Boolean  @default(false)
  status                String   @default("PENDING") @db.VarChar(30)
  refundStatus          String?  @db.VarChar(30)
  amount                Decimal  @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingAddress {
  id         Int    @id @default(autoincrement())
  orderId    Int    @unique
  line1      String @db.NVarChar(250)
  line2      String? @db.NVarChar(250)
  city       String @db.NVarChar(120)
  state      String @db.NVarChar(120)
  postalCode String @db.VarChar(20)
  country    String @default("India") @db.NVarChar(120)
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  discountType    String   @db.VarChar(30)
  discountValue   Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  usageLimit      Int?
  usedCount       Int      @default(0)
  orders          Order[]
}
