NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5174

# Local SQL Server Express/Developer connection. Wrap special-character passwords in {braces}.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DivaCandlesDB
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_RETRIES=5
DB_STORAGE_LIMIT_MB=
DATABASE_URL="sqlserver://localhost:1433;database=DivaCandlesDB;user=sa;password={YOUR_PASSWORD};encrypt=true;trustServerCertificate=true;schema=dbo"

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_NAME=DIVA Candles Administrator
ADMIN_EMAIL=info.divacandles@gmail.com
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

IMAGE_PROVIDER=local
BACKEND_PUBLIC_URL=http://localhost:8080
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=DIVA Candles
EMAIL_FROM_ADDRESS=
NOTIFICATION_EMAIL=info.divacandles@gmail.com
WHATSAPP_NUMBER=918421869308
WHATSAPP_CLOUD_API_ENABLED=false
RAZORPAY_ENABLED=false
COOKIE_SECURE=false
